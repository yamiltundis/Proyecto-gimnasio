generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id                Int               @id @default(autoincrement())
  nombre            String
  apellido          String
  dni               Int
  fechaNacimiento   DateTime
  email             String            @unique
  foto              String
  rol               String
  password          String            @default("")
  asistencias       Asistencia[]
  asistenciasClases AsistenciaClase[]
  membreciasActivas MembreciaActiva[]
  pagos             Pago[]
  reservas          Reserva[]
}

model TipoClase {
  id                Int               @id @default(autoincrement())
  nombre            String
  clasesEspecificas ClaseEspecifica[]
}

model ClaseEspecifica {
  id               Int               @id @default(autoincrement())
  diaHora          DateTime
  cantmax          Int
  tipoClaseId      Int
  asistenciasClase AsistenciaClase[]
  tipoClase        TipoClase         @relation(fields: [tipoClaseId], references: [id])
  reservas         Reserva[]

  @@index([tipoClaseId], map: "ClaseEspecifica_tipoClaseId_fkey")
}

model TipoMembrecia {
  id            Int           @id @default(autoincrement())
  nombre        String
  dias          Int
  listasPrecios ListaPrecio[]
  pagos         Pago[]
}

model ListaPrecio {
  id              Int           @id @default(autoincrement())
  monto           Int
  diaInicial      DateTime
  tipoMembreciaId Int
  tipoMembrecia   TipoMembrecia @relation(fields: [tipoMembreciaId], references: [id])

  @@index([tipoMembreciaId], map: "ListaPrecio_tipoMembreciaId_fkey")
}

model Pago {
  id                Int               @id @default(autoincrement())
  monto             Int
  fecha             DateTime
  clienteId         Int
  tipoMembreciaId   Int
  membreciasActivas MembreciaActiva[]
  cliente           Usuario           @relation(fields: [clienteId], references: [id])
  tipoMembrecia     TipoMembrecia     @relation(fields: [tipoMembreciaId], references: [id])

  @@index([clienteId], map: "Pago_clienteId_fkey")
  @@index([tipoMembreciaId], map: "Pago_tipoMembreciaId_fkey")
}

model MembreciaActiva {
  Id          Int      @id @default(autoincrement())
  fechaInicio DateTime
  fechaFin    DateTime
  clienteId   Int
  pagoId      Int
  cliente     Usuario  @relation(fields: [clienteId], references: [id])
  pago        Pago     @relation(fields: [pagoId], references: [id])

  @@index([clienteId], map: "MembreciaActiva_clienteId_fkey")
  @@index([pagoId], map: "MembreciaActiva_pagoId_fkey")
}

model Reserva {
  id                Int              @id @default(autoincrement())
  fechaReserva      DateTime
  estado            String
  clienteId         Int
  claseEspecificaId Int
  asistencia        AsistenciaClase? @relation("ReservaAsistencia")
  claseEspecifica   ClaseEspecifica  @relation(fields: [claseEspecificaId], references: [id])
  cliente           Usuario          @relation(fields: [clienteId], references: [id])

  @@index([claseEspecificaId], map: "Reserva_claseEspecificaId_fkey")
  @@index([clienteId], map: "Reserva_clienteId_fkey")
}

model AsistenciaClase {
  id                Int             @id @default(autoincrement())
  horacheckin       DateTime
  clienteId         Int
  claseEspecificaId Int
  reservaId         Int?            @unique
  claseEspecifica   ClaseEspecifica @relation(fields: [claseEspecificaId], references: [id])
  cliente           Usuario         @relation(fields: [clienteId], references: [id])
  reserva           Reserva?        @relation("ReservaAsistencia", fields: [reservaId], references: [id])

  @@index([claseEspecificaId], map: "AsistenciaClase_claseEspecificaId_fkey")
  @@index([clienteId], map: "AsistenciaClase_clienteId_fkey")
}

model Asistencia {
  id        Int      @id @default(autoincrement())
  fechaHora DateTime
  clienteId Int
  cliente   Usuario  @relation(fields: [clienteId], references: [id])

  @@index([clienteId], map: "Asistencia_clienteId_fkey")
}
